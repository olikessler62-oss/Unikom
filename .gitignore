node_modules/
dist/
*.log
.DS_Store

# Internes Arbeitsverzeichnis der Anwendung (Staging, Spec Abschnitt 43)
application-data/

# Quell-/Zielverzeichnisse der Beispielausführung aus src/index.ts
demo/
demo-quelle/
demo-ziel/

# Lokale Claude-Code-Einstellungen; .claude/settings.json bleibt versioniert
.claude/settings.local.json

# Zugangsdaten echter Prüfserver. Die Vorlage daneben ist versioniert, diese
# Datei nie: Sie enthält Kennwörter und private Schlüssel im Klartext.
testserver.local.json
testserver.local.key

# Von Hand abgelegte Zugänge. Breit gefasst mit Absicht: Eine Zugangsdatei, die
# durch das Raster fällt, merkt niemand, bis sie im Verlauf des Projekts steht.
SFTP_Zugang.txt
*Zugang*.txt
*zugang*.txt
*.pem
*.ppk
id_rsa*
id_ed25519*

# Ausgenommen: das selbstsignierte Zertifikat des FTPS-Testservers. Es ist
# öffentlich, gehört zum Bauwerk und muss jedem Klon vorliegen.
!src/testing/certs/test-cert.pem
!src/testing/certs/test-key.pem

# Aus dem Fallkatalog erzeugt (npm run testdaten)
testdaten/

# Proben zum Ausprobieren von Hand (npm run teilnehmer, npm run bestellungen).
# Erzeugt und nicht gepflegt: Die Quelle steht in src/tools, und wer sie
# ändert, bekommt den Ordner neu. Versioniert wäre er ein zweiter Stand,
# der irgendwann vom ersten abweicht.
Testdateien/
